PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://phonemail:phonemail-local@localhost:5432/phonemail
JWT_SECRET=change-this-to-a-long-random-secret
EMAIL_DOMAIN=phonemail.com

# otp (preferred) or password (fallback). local OTP works only for development.
AUTH_MODE=otp
OTP_PROVIDER=local

# Twilio Verify + Messaging + Voice. Trial accounts only deliver to verified numbers
# and have trial message/template restrictions. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
APP_URL=https://your-public-domain.example

# Shared secret for the external inbound-email webhook.
INBOUND_WEBHOOK_SECRET=replace-with-a-long-random-value
